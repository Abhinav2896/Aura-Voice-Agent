# Next.js & Frontend .gitignore
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing
coverage/
.nyc_output/

# Next.js build outputs & cache
.next/
out/
build/
dist/
.swc/
.cache/
.turbo/
.vercel/

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment files
.env*
!.env*.example
!.env.template
!.env.sample

# TypeScript
*.tsbuildinfo
next-env.d.ts

# OS & Editor
.DS_Store
Thumbs.db
