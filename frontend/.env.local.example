# Aura Frontend Environment Configuration (EXAMPLE)
# Copy this file to `.env.local` and fill in real values. NEVER commit the real file.
#
# IMPORTANT: Only NEXT_PUBLIC_* variables reach the browser. Never put a secret
# (Gemini key, Supabase service-role key, DB password) in a NEXT_PUBLIC_* var.
# The service-role key must NEVER appear here.

# Base URL of the FastAPI backend the browser talks to.
NEXT_PUBLIC_FASTAPI_URL=http://localhost:8000

# Voice provider: 'gemini' (real Live relay) or 'mock' (offline dev provider).
NEXT_PUBLIC_VOICE_PROVIDER=gemini

# Supabase project URL (public, safe for the browser).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase ANON key ONLY. This key is public-by-design for browser auth and is
# constrained by Row Level Security. NEVER put the service-role key here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Admin Dashboard Authentication (Server-side credentials for /admin portal)
ADMIN_USERNAME=admin_username_here
ADMIN_PASSWORD=admin_password_here
# HMAC secret for admin session tokens. MUST match backend/.env ADMIN_SESSION_SECRET
# exactly — the backend verifies the token this key mints for admin REST endpoints.
ADMIN_SESSION_SECRET=change_me_to_a_secure_random_string

