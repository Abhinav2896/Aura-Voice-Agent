# Aura Backend Environment Configuration (EXAMPLE)
# Copy this file to `.env` and fill in real values. NEVER commit the real .env.
# All values here are server-side only and must never be exposed to the browser.

# Google Gemini API key — used for Live voice, post-call extraction, and embeddings.
# Backend-only. Do NOT prefix with NEXT_PUBLIC_ and never send to the frontend.
GEMINI_API_KEY=your_gemini_api_key

# Supabase project URL, e.g. https://your-project-ref.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase SERVICE ROLE key — bypasses Row Level Security. Backend-only, highest-
# value secret. Never expose to the browser or place in any NEXT_PUBLIC_* variable.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Supabase ANON key — used only for verifying end-user JWTs (auth.get_user).
SUPABASE_ANON_KEY=your_anon_key

# Runtime environment: development | production
ENVIRONMENT=development

# Port the FastAPI/uvicorn server listens on.
PORT=8000

# Comma-separated list of allowed CORS origins (the frontend origins).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Shared HMAC secret for admin session tokens. MUST match the frontend's
# ADMIN_SESSION_SECRET exactly — the backend uses it to verify the X-Admin-Token
# minted by the frontend for admin-only REST endpoints. Backend-only; never
# expose to the browser. Generate a long random value (e.g. `openssl rand -hex 32`).
# If unset, all admin endpoints fail closed (403).
ADMIN_SESSION_SECRET=your_admin_session_secret
